{
  "name": "pedal-gacha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build --outDir dist/client && vite build --ssr worker/index.js --outDir dist/server",
    "audit:generation": "esbuild scripts/audit-generation.ts --bundle --platform=node --format=esm --packages=external --loader:.css=empty --outfile=.tmp/audit-generation.mjs && node .tmp/audit-generation.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "gsap": "^3.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
